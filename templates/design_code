<p class="text-xs text-slate-500 font-medium uppercase tracking-wider mt-0.5">The Clinical Sanctuary • Session Planner</p>
</div>
<button class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-teal-50/50 transition-colors text-slate-500">
<span class="material-symbols-outlined">close</span>
</button>
</header>
<form class="p-8 space-y-8 overflow-y-auto max-h-[calc(100vh-200px)]">
<div>
<label class="block text-sm font-bold text-secondary mb-2 tracking-tight">Session Title</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium placeholder:text-slate-400" placeholder="e.g., Mindfulness &amp; Recovery Group A" type="text"/>
</div>
<div class="grid grid-cols-3 gap-6">
<div>
<label class="block text-sm font-bold text-secondary mb-2 tracking-tight">Date</label>
<div class="relative">
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium" type="date"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-secondary mb-2 tracking-tight">Start Time</label>
<input class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium" type="time"/>
</div>
<div>
<label class="block text-sm font-bold text-secondary mb-2 tracking-tight">Duration</label>
<select class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium appearance-none">
<option>45 Minutes</option>
<option>60 Minutes</option>
<option>90 Minutes</option>
<option>2 Hours</option>
</select>
</div>
</div>
<div class="bg-surface-container-low p-6 rounded-lg space-y-6">
<div class="flex items-center justify-between">
<div>
<p class="font-bold text-teal-900 tracking-tight">Location Details</p>
<p class="text-xs text-secondary mt-1">Specify where this group will meet</p>
</div>
<label class="flex items-center cursor-pointer group">
<div class="relative">
<input class="sr-only peer" type="checkbox"/>
<div class="w-11 h-6 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-[transform,border-color] peer-checked:bg-primary"></div>
</div>
<span class="ml-3 text-sm font-semibold text-secondary">Online (Zoom)</span>
</label>
</div>
<div class="relative">
<span class="material-symbols-outlined absolute left-4 top-4 text-slate-400">location_on</span>
<input class="w-full bg-surface-container-lowest border border-outline-variant/20 rounded-lg p-4 pl-12 focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium" placeholder="Physical Room or Meeting URL" type="text"/>
</div>
</div>
<div>
<label class="block text-sm font-bold text-secondary mb-2 tracking-tight">Session Description</label>
<textarea class="w-full bg-surface-container-highest border-none rounded-lg p-4 focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-fixed transition-colors text-on-surface font-medium placeholder:text-slate-400 resize-none" placeholder="Outline clinical goals, required materials, or patient guidelines..." rows="4"></textarea>
</div>
</form>
<footer class="p-8 bg-slate-50/50 flex items-center justify-end gap-4 border-t border-slate-200/50">
<button class="px-6 py-2.5 text-primary font-bold hover:bg-teal-50/50 transition-colors rounded-lg">Cancel</button>
<button class="bg-gradient-to-br from-primary-container to-primary text-on-primary px-10 py-3 rounded-lg font-bold shadow-md active:scale-95 transition-transform flex items-center gap-2">
<span class="material-symbols-outlined text-[20px]">save</span>
                    Save Session
                </button>
</footer>
</div>
</div>
</body></html>