# Required
DOMAIN=clinic.lior-clinic.org
SECRET_KEY=replace-with-a-long-random-secret
TLS_EMAIL=ops@yourdomain.com
BACKUP_ENCRYPTION_KEY=replace-with-a-base64-fernet-key

# Google OAuth (Calendar, Docs, Drive integration)
# Get these from: https://console.cloud.google.com/apis/credentials
# In Google Cloud Console:
#   1. Create an OAuth 2.0 Client ID (Web application)
#   2. Add Authorized redirect URI: https://<your-domain>/admin/google-calendar/callback
#   3. Copy the Client ID and Client Secret here
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Optional: override the base URL used for OAuth callback construction
# Leave this unset to use the live request URL automatically (recommended).
# APP_BASE_URL=https://clinic.lior-clinic.org

# SMTP — outbound email (password-reset, notifications, appointment reminders).
# Leave all SMTP_* vars unset or empty to disable email silently.
#
# --- SendGrid Configuration (recommended) ---
# 1. Sign up at https://sendgrid.com (free tier: 100 emails/day)
# 2. Create an API Key: Settings → API Keys → Create API Key → Full Access
# 3. Verify a Single Sender: Settings → Sender Authentication → Verify a Single Sender
#    Use the same email as SMTP_FROM_EMAIL below
# 4. Set SMTP_PASSWORD to the API key (starts with "SG.")
#
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-with-sendgrid-api-key
SMTP_FROM_EMAIL=alonim.lior@gmail.com
SMTP_USE_TLS=1
#
# --- Alternative: Gmail (requires 2FA + App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=alonim.lior@gmail.com
# SMTP_PASSWORD=replace-with-gmail-app-password
# SMTP_FROM_EMAIL=alonim.lior@gmail.com
# SMTP_USE_TLS=1
#
# --- Alternative: AWS SES ---
# SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-with-ses-smtp-username
# SMTP_PASSWORD=replace-with-ses-smtp-password
# SMTP_FROM_EMAIL=alonim.lior@gmail.com
# SMTP_USE_TLS=1
#
# Appointment Reminders
REMINDER_HOURS_BEFORE=24     # Hours before appointment to send reminder
REMINDER_SCHEDULER_INTERVAL=300  # How often (seconds) the scheduler checks for reminders

# Incoming Email (IMAP) — optional, for capturing patient replies as messages
# To use: set up a mailbox with IMAP access and uncomment below.
# IMAP_HOST=imap.your-provider.com
# IMAP_PORT=993
# IMAP_USERNAME=admin@clinic.lior-clinic.org
# IMAP_PASSWORD=replace-with-password
# IMAP_USE_SSL=1
# IMAP_FOLDER=INBOX
# IMAP_POLL_INTERVAL=300